# === Chon MOT trong hai provider — code tu nhan theo key nao co gia tri ===
# Neu dien ca hai, OpenAI duoc uu tien. Dat VLEARNNOTE_PROVIDER=gemini de ep dung Gemini.

# --- OpenAI ---
OPENAI_API_KEY=
# Tuy chon: them key de tu dong xoay vong khi 1 key bi rate-limit
# OPENAI_API_KEY_2=

# --- Google Gemini (lay tu Google AI Studio) ---
# Luu y: free tier gioi han ~20 request/ngay/model -> nen dien nhieu key.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# === Tuy chon ===
# Ep provider: openai | gemini (bo trong = tu nhan theo key)
VLEARNNOTE_PROVIDER=

# Model. De trong = mac dinh theo provider (openai: gpt-4o-mini, gemini: gemini-2.5-flash).
# Neu ten model khong thuoc ho cua provider dang dung thi bi bo qua va ghi canh bao,
# tranh truong hop de gemini-2.5-flash nhung lai chay bang key OpenAI.
VLEARNNOTE_MODEL=
# Chi dinh rieng cho tung provider (uu tien hon VLEARNNOTE_MODEL):
# VLEARNNOTE_MODEL_OPENAI=gpt-4o-mini
# VLEARNNOTE_MODEL_GEMINI=gemini-2.5-flash

VLEARNNOTE_TIMEOUT_SECONDS=20
